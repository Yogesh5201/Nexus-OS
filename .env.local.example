# ============================================================
# NEXUS — Environment Variables (ALL OPTIONAL)
# The app runs fully offline with zero configuration.
# Add keys here (rename this file to .env.local) to enable cloud features.
# ============================================================

# --- Google Gemini (AI Assistant) ---------------------------
# Get a key at https://aistudio.google.com/app/apikey
# Without it, the AI Assistant uses a local simulated engine.
GEMINI_API_KEY=
# Optional: override the default model
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase (Auth + Firestore + Storage, optional) --------
# Without these, NEXUS persists everything to localStorage.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- MongoDB Atlas (primary database, server-only) ----------
# NEVER prefix these with NEXT_PUBLIC — they must stay on the server.
# Without them, NEXUS runs offline-only (localStorage); cloud sync is disabled.
# Connection string from Atlas → Connect → Drivers.
MONGODB_URI=
# Database name (defaults to "nexus" if omitted).
MONGODB_DB=nexus

# --- Firebase Admin (server-side ID-token verification) -----
# Service account from Firebase Console → Project settings → Service accounts →
# Generate new private key. Required to verify ID tokens on protected API routes.
# Keep the private key on ONE line with literal "\n" for newlines.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Backblaze B2 (File Manager object storage, server-only) ----
# Stores the actual file BYTES (metadata stays in MongoDB). NEVER prefix with
# NEXT_PUBLIC — the application key must stay on the server. Without these, the
# File Manager keeps working but stores bytes locally only (browser IndexedDB);
# files won't sync across devices until B2 is configured.
# Create a bucket + application key at https://www.backblaze.com/ (B2 Cloud Storage).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
