{
  "name": "nexus-os",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS — a futuristic AI-powered operating system that runs entirely in the browser.",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "electron": "electron electron/main/index.js",
    "electron:dev": "concurrently -k -n next,electron \"next dev\" \"wait-on http://localhost:3000 && cross-env NEXT_URL=http://localhost:3000 electron electron/main/index.js\"",
    "electron:build": "next build",
    "electron:start": "cross-env NODE_ENV=production electron electron/main/index.js",
    "electron:prod": "concurrently -k -n next,electron \"next start\" \"wait-on http://localhost:3000 && cross-env NEXT_URL=http://localhost:3000 electron electron/main/index.js\"",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@tanstack/react-query": "^5.59.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^11.11.9",
    "gsap": "^3.12.5",
    "lucide-react": "^0.453.0",
    "mongodb": "^6.21.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nexus.os",
    "productName": "Nexus OS",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
